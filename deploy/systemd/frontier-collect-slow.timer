[Unit]
Description=Collect Frontier slow sources before each UTC slice publish

[Timer]
Unit=frontier-collect@slow.service
# Runs after the medium snapshot and before the fast snapshot; each collector takes
# the shared snapshot lock, so the tiers are staggered rather than concurrent.
OnCalendar=*-*-* 23:10:00 UTC
OnCalendar=*-*-* 11:10:00 UTC
Persistent=true

[Install]
WantedBy=timers.target
