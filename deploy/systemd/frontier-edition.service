[Unit]
Description=Build the curated Frontier daily edition
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/alex/alex/forager
EnvironmentFile=/home/alex/.config/frontier/frontier.env
ExecStart=/usr/bin/python3 -m scripts.local_collect --group slow --output /home/alex/alex/forager/web/public/data --process-only --no-publish
TimeoutStartSec=45min
