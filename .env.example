# Local collection and editorial pipeline
# Copy to ~/.config/frontier/frontier.env for the bundled systemd user units.
FRONTIER_TRANSLATION_ENDPOINT=https://api.example.com/v1
FRONTIER_TRANSLATION_API_KEY=replace-with-an-api-key
FRONTIER_TRANSLATION_MODEL=replace-with-a-model-id

# Optional model/provider fallbacks and reliability controls
FRONTIER_LLM_FALLBACK_MODELS=
FRONTIER_EDITOR_MODELS=
FRONTIER_LLM_MAX_TOKENS=4096
FRONTIER_LLM_RETRIES=3
FRONTIER_YOUTUBE_API_KEY=

# Optional private pipeline state. Defaults to ~/.local/share/frontier.
# FRONTIER_STATE_DIR=/absolute/path/to/frontier-state

# Web and Cloudflare deployment
NEXT_PUBLIC_SITE_URL=http://localhost:5173
NEXT_PUBLIC_FRONTIER_DATA_URL=/api/data
# Local Next.js can read the production API without copying JSON into web/public.
FRONTIER_REMOTE_DATA_URL=https://frontiermemo.com/api/data
# Or point server-side reads at a local preview directory.
# FRONTIER_DATA_DIR=/absolute/path/to/frontier-state/preview
NEXT_PUBLIC_CONTACT_EMAIL=
OPENROUTER_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
